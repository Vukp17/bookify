# Production Environment Variables
# Copy this to /opt/bookify/.env on your Hetzner server

# Database Configuration (use your actual PostgreSQL connection)
DATABASE_URL=postgresql://bookify:your_strong_password@db_host:5432/bookify?schema=public

# Application Port (internal container port)
PORT=3000

# JWT Secret (change this to a strong random string)
JWT_SECRET=change-this-to-a-very-long-random-secure-string-in-production

# CORS Origin (your production frontend URL)
CORS_ORIGIN=https://yourdomain.com

# PostgreSQL credentials (if using docker-compose)
POSTGRES_USER=bookify
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=bookify
